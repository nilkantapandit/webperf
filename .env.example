# =========================
# WebPerf Diagnostics
# =========================
SITE_URL=https://www.example.com
SITE_NAME=WebPerf Diagnostics
SITE_DESCRIPTION=Free website speed, SEO, accessibility and best-practices checker with plain-English recommendations.

# Flask / sessions
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
PORT=5000
DATABASE_PATH=./webperf.db
# Keep this file outside versioned source folders in production/dev if you want accounts to survive code updates.
# Example Windows: DATABASE_PATH=E:/webperf-data/webperf.db

# Google PageSpeed Insights
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_STRATEGY=mobile
ANALYSIS_CACHE_HOURS=6

# Competitor discovery provider — use serper for local testing, google_places for production.
COMPETITOR_PROVIDER=serper
# Serper — Google Search results for local testing. Free trial credits are available on signup.
SERPER_API_KEY=
# Brave Search API — optional alternate test provider.
BRAVE_SEARCH_API_KEY=
# Google Places API (New) — switch COMPETITOR_PROVIDER=google_places after billing is enabled.
# Restrict this key to Places API and your production server IP before launch.
GOOGLE_PLACES_API_KEY=
COMPETITOR_CACHE_DAYS=7

# Razorpay one-time Competitor Report unlock
# ₹99 = 9900 paise in INR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Leave empty until you have a public HTTPS webhook URL.
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_AMOUNT_MINOR=9900
PREMIUM_CURRENCY=INR
PREMIUM_DISPLAY_PRICE=₹99
PREMIUM_NAME=Competitor Report

# Local testing only. Keep false in production.
DEV_PREMIUM_UNLOCK=false

# Admin panel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Contact email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Legal / public business details — replace before launch
LEGAL_CONTACT_EMAIL=hello@example.com
BUSINESS_NAME=WebPerf Diagnostics
BUSINESS_ADDRESS=Update this address before launch.
